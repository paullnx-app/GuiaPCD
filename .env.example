# URL canônica do site (sitemap, robots, Open Graph, llms.txt).
NEXT_PUBLIC_SITE_URL=https://www.guiapcd.com.br

# E-mail que receberá os leads (destino dos formulários e resumo do chat).
NEXT_PUBLIC_LEAD_EMAIL=contato@guiapcd.com.br

# Resend (https://resend.com) — envio de formulários pelo servidor (/api/lead).
# 1) Crie conta e API Key em https://resend.com/api-keys
# 2) Domains → adicione guiapcd.com.br → copie os registros DNS para o Cloudflare
# 3) Após verificar o domínio, defina o remetente:
RESEND_API_KEY=
RESEND_FROM=Site Guia PcD <contato@guiapcd.com.br>

# Anthropic – chave de API para o assistente (Claude 3 Haiku) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Depoimentos do Google (Google Meu Negócio) – Places API, Details
# 1) Google Cloud Console → APIs → ativar "Places API"
# 2) Criar chave de API (restrinja por IP do servidor ou por API)
# 3) Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# (Opcional) Link direto da página do negócio no Google Maps (rodapé da seção de depoimentos)
# NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://maps.app.goo.gl/...

# STANDBY — Calendly (agendamento online desativado; chat direciona para WhatsApp)
# Para reativar no futuro, veja README seção "Calendly (standby)".
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/seu-usuario/tipo-evento
# CALENDLY_URL=
